# /etc/systemd/system/viaductd.service
# Installed by deploy/provision.sh. Config comes from /etc/viaduct/viaductd.env
# (BASE_DOMAIN + TLS_CERT/TLS_KEY paths). No auth and no database, so nothing
# else is needed. Anyone who can reach the tunnel port can open a tunnel —
# restrict it at the firewall if that matters.

[Unit]
Description=Viaduct tunnel server
After=network-online.target caddy.service
Wants=network-online.target

[Service]
User=viaduct
Group=viaduct
EnvironmentFile=/etc/viaduct/viaductd.env
# Copy Caddy's managed apex cert into a viaduct-readable spot before start.
# The '+' runs this as root so it can read Caddy's 0600 private key; without it
# viaductd (user viaduct) can't read the key and crash-loops (Caddy 502s).
ExecStartPre=+/usr/local/sbin/viaductd-sync-cert
ExecStart=/usr/local/bin/viaductd \
    --bind 0.0.0.0 \
    --base-domain ${BASE_DOMAIN} \
    --tls-cert ${TLS_CERT} \
    --tls-key ${TLS_KEY}
Restart=always
RestartSec=5
LimitNOFILE=65535
# viaductd drains active connections on SIGTERM (30s), then exits.
KillSignal=SIGTERM
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
