# /etc/systemd/system/viaductd.service
# Env file (root:viaduct, 640) provides TLS_CERT/TLS_KEY paths pointing at
# Caddy's managed wildcard certificate (see setup.md). viaductd has no auth and
# no database, so nothing else is needed. Anyone who can reach the tunnel port
# can open a tunnel — restrict it at the firewall if that matters.

[Unit]
Description=Viaduct tunnel server
After=network-online.target
Wants=network-online.target

[Service]
User=viaduct
Group=viaduct
SupplementaryGroups=caddy
EnvironmentFile=/etc/viaduct/viaductd.env
ExecStart=/usr/local/bin/viaductd \
    --bind 0.0.0.0 \
    --base-domain viaduct.sh \
    --tls-cert ${TLS_CERT} \
    --tls-key ${TLS_KEY}
Restart=always
RestartSec=5
LimitNOFILE=65535
# viaductd drains active connections on SIGTERM (30s), then exits.
KillSignal=SIGTERM
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
