# /etc/systemd/system/viaductd.service
# Env file (root:viaduct, 640) provides DO_API_TOKEN plus TLS_CERT/TLS_KEY
# paths pointing at Caddy's managed wildcard certificate (see setup.md).

[Unit]
Description=Viaduct tunnel server
After=network-online.target
Wants=network-online.target

[Service]
User=viaduct
Group=viaduct
SupplementaryGroups=caddy
EnvironmentFile=/etc/viaduct/viaductd.env
ExecStart=/usr/local/bin/viaductd \
    --bind 0.0.0.0 \
    --base-domain viaduct.sh \
    --db /var/lib/viaduct/viaduct.db \
    --tls-cert ${TLS_CERT} \
    --tls-key ${TLS_KEY}
Restart=always
RestartSec=5
StateDirectory=viaduct
LimitNOFILE=65535
# viaductd drains active connections on SIGTERM (30s), then exits.
KillSignal=SIGTERM
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
